{
  "info": {
    "name": "THREAD - Staff, Catalog & Operations API",
    "description": "Postman collection for Staff (Developer B - Utso) covering Categories, Collections, Products, Variants, Size Guides, and Returns.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "collectionId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "variantId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Public - Get Published Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
      }
    },
    {
      "name": "2. Public - Get Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
      }
    },
    {
      "name": "3. Public - Get Collections",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/collections", "host": ["{{baseUrl}}"], "path": ["collections"] }
      }
    },
    {
      "name": "4. Staff - Create Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('categoryId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Shirts & Tops\",\n  \"slug\": \"shirts-tops\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/categories", "host": ["{{baseUrl}}"], "path": ["staff", "categories"] }
      }
    },
    {
      "name": "5. Staff - Create Collection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('collectionId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Summer 2026 Collection\",\n  \"slug\": \"summer-2026-collection\",\n  \"isActive\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/collections", "host": ["{{baseUrl}}"], "path": ["staff", "collections"] }
      }
    },
    {
      "name": "6. Staff - Create Product with Variants (Atomic Transaction)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('productId', jsonData.data.id);",
              "    if (jsonData.data.variants && jsonData.data.variants.length > 0) {",
              "        pm.collectionVariables.set('variantId', jsonData.data.variants[0].id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"French Linen Short-Sleeve Shirt\",\n  \"slug\": \"french-linen-short-sleeve-shirt\",\n  \"description\": \"Tailored from 100% French flax linen. Cool, breathable and effortlessly relaxed.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"collectionIds\": [\"{{collectionId}}\"],\n  \"variants\": [\n    {\n      \"sku\": \"FLS-WHT-S\",\n      \"size\": \"S\",\n      \"color\": \"White\",\n      \"priceMinor\": 285000,\n      \"isActive\": true\n    },\n    {\n      \"sku\": \"FLS-WHT-M\",\n      \"size\": \"M\",\n      \"color\": \"White\",\n      \"priceMinor\": 285000,\n      \"isActive\": true\n    },\n    {\n      \"sku\": \"FLS-WHT-L\",\n      \"size\": \"L\",\n      \"color\": \"White\",\n      \"priceMinor\": 285000,\n      \"isActive\": true\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/products", "host": ["{{baseUrl}}"], "path": ["staff", "products"] }
      }
    },
    {
      "name": "7. Staff - Publish Product",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/staff/products/{{productId}}/publish", "host": ["{{baseUrl}}"], "path": ["staff", "products", "{{productId}}", "publish"] }
      }
    },
    {
      "name": "8. Staff - Create/Configure Size Guide",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Linen Shirt Standard Sizing\",\n  \"ranges\": [\n    {\n      \"size\": \"S\",\n      \"minHeightCm\": 165.0,\n      \"maxHeightCm\": 172.0,\n      \"minWeightKg\": 58.0,\n      \"maxWeightKg\": 66.0,\n      \"minChestCm\": 88.0,\n      \"maxChestCm\": 94.0\n    },\n    {\n      \"size\": \"M\",\n      \"minHeightCm\": 170.0,\n      \"maxHeightCm\": 178.0,\n      \"minWeightKg\": 65.0,\n      \"maxWeightKg\": 75.0,\n      \"minChestCm\": 94.0,\n      \"maxChestCm\": 102.0\n    },\n    {\n      \"size\": \"L\",\n      \"minHeightCm\": 176.0,\n      \"maxHeightCm\": 186.0,\n      \"minWeightKg\": 74.0,\n      \"maxWeightKg\": 85.0,\n      \"minChestCm\": 102.0,\n      \"maxChestCm\": 110.0\n    }\n  ]\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/products/{{productId}}/size-guide", "host": ["{{baseUrl}}"], "path": ["staff", "products", "{{productId}}", "size-guide"] }
      }
    },
    {
      "name": "9. Public - Get Product Size Guide",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{productId}}/size-guide", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "size-guide"] }
      }
    },
    {
      "name": "10. Staff - Update Variant Price (Audited)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priceMinor\": 299000\n}"
        },
        "url": { "raw": "{{baseUrl}}/staff/products/{{productId}}/variants/{{variantId}}", "host": ["{{baseUrl}}"], "path": ["staff", "products", "{{productId}}", "variants", "{{variantId}}"] }
      }
    },
    {
      "name": "11. Staff - List Returns",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/staff/returns", "host": ["{{baseUrl}}"], "path": ["staff", "returns"] }
      }
    }
  ]
}
