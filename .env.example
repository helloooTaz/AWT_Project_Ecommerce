# Replace the placeholders with your local PostgreSQL role and database.
# Percent-encode special characters in the username or password.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/thread
# Generate a deployment-specific secret as documented in the README.
JWT_SECRET=
PORT=3000
SWAGGER_ENABLED=true
# Set to MOCK for the local payment demo. Generate a separate random secret.
PAYMENT_PROVIDER=DISABLED
MOCK_PAYMENT_SIGNING_SECRET=
# Automatic expiry defaults to enabled outside tests. Set to false to pause it.
# ORDER_EXPIRY_ENABLED=true
ORDER_EXPIRY_POLL_INTERVAL_MS=60000
ORDER_EXPIRY_BATCH_SIZE=25
